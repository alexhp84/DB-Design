<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="sliceanddice" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure pragmas query browser" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2099"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="customers" custom_title="0" dock_id="1" table="4,9:maincustomers"/><dock_state state="000000ff00000000fd00000001000000020000057100000368fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005710000014800ffffff000002d40000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="customers" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="57"/><column index="2" value="69"/><column index="3" value="70"/><column index="4" value="70"/><column index="5" value="86"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE customers (
	cust_id INTEGER PRIMARY KEY AUTOINCREMENT,
	cust_add TEXT NOT NULL,
	cust_city TEXT NOT NULL,
	cust_dob TEXT,
	cust_phone INTEGER NOT NULL
	);
	
CREATE TABLE drinks (
	drink_id INTEGER PRIMARY KEY AUTOINCREMENT,
	drink_name TEXT NOT NULL,
	drink_type TEXT CHECK (drink_type IN ('soft drink', 'alcoholic drink', 'water/other'))
	);

CREATE TABLE toppings (
	topping_id INTEGER PRIMARY KEY AUTOINCREMENT,
	topping_name TEXT NOT NULL,
	topping_type TEXT CHECK (topping_type IN ('vegetarian', 'vegan', 'meat', 'sauce')),
	topping_price REAL NOT NULL
	);

CREATE TABLE pizzas (
	pizza_id INTEGER PRIMARY KEY AUTOINCREMENT,
	pizza_name TEXT UNIQUE NOT NULL,
	pizza_price REAL NOT NULL
	);
	
CREATE TABLE orders (
	order_id INTEGER PRIMARY KEY AUTOINCREMENT,
	cust_id INTEGER NOT NULL,
	order_time datetime NOT NULL,
	order_notes TEXT,
	delivery_time datetime NOT NULL,
	FOREIGN KEY (cust_id) REFERENCES customers(cust_id)
	);
	
CREATE TABLE order_drinks (
	order_id INTEGER NOT NULL,
	drink_id INTEGER NOT NULL,
	quantity INTEGER NOT NULL,
	order_price REAL NOT NULL,
	FOREIGN KEY (order_id) REFERENCES orders(order_id),
	FOREIGN KEY (drink_id) REFERENCES drinks(drink_id),
	PRIMARY KEY (order_id, drink_id)
	);
	
CREATE TABLE order_pizzas (
	order_id INTEGER NOT NULL,
	pizza_id INTEGER NOT NULL,
	quantity INTEGER NOT NULL,
	order_price REAL NOT NULL,
	FOREIGN KEY (order_id) REFERENCES orders(order_id),
	FOREIGN KEY (pizza_id) REFERENCES pizzas(pizza_id),
	PRIMARY KEY (order_id, pizza_id)
	);

CREATE TABLE order_pizza_topping (
	order_id INTEGER NOT NULL,
	pizza_id INTEGER NOT NULL,
	topping_id INTEGER NOT NULL,
	order_price REAL NOT NULL,
	FOREIGN KEY (order_id, pizza_id) REFERENCES order_pizzas(order_id, pizza_id),
	FOREIGN KEY (topping_id) REFERENCES toppings(topping_id),
	PRIMARY KEY (order_id, pizza_id, topping_id)
	);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
